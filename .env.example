# Renomeie este arquivo para .env e preencha.

# --- SHOPEE (affiliate.shopee.com.br -> Open API) ---
SHOPEE_APP_ID=
SHOPEE_SECRET=

# --- MERCADO LIVRE ---
# 1) Crie um app grátis em https://developers.mercadolivre.com.br (Minhas aplicações)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# 2) No painel de afiliados do ML, gere o link de qualquer produto, abra ele e copie
#    a parte depois do "?" que tem matt_... Exemplo:
#    ML_AFILIADO_PARAMS=matt_word=seuusuario&matt_tool=12345678
ML_AFILIADO_PARAMS=

# --- TELEGRAM ---
# Crie o bot no @BotFather e coloque ele como ADMIN do seu canal
TELEGRAM_TOKEN=
TELEGRAM_CANAL=@seucanal
# Seu chat id (pegue no @userinfobot) pra receber aviso quando der erro
TELEGRAM_ADMIN=

# --- OPCIONAL: frase de abertura dos posts feita por IA ---
ANTHROPIC_API_KEY=
